{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "80rem",
      "wideSize": "88rem"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "name": "Electric Cyan (Primary)",
          "slug": "primary",
          "color": "#0278B3"
        },
        {
          "name": "Deep Ink",
          "slug": "ink",
          "color": "#0E1116"
        },
        {
          "name": "Soft Mist",
          "slug": "mist",
          "color": "#F4F8FB"
        },
        {
          "name": "Warm Amber",
          "slug": "amber",
          "color": "#F5A623"
        },
        {
          "name": "Dark Charcoal (Foreground)",
          "slug": "foreground",
          "color": "#1E252E"
        },
        {
          "name": "Pure White (Background)",
          "slug": "background",
          "color": "#FFFFFF"
        },
        {
          "name": "Card Surface",
          "slug": "card",
          "color": "#FFFFFF"
        },
        {
          "name": "Muted Slate",
          "slug": "muted-foreground",
          "color": "#64748B"
        },
        {
          "name": "Border Gray",
          "slug": "border",
          "color": "#E2E8F0"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textColumns": false,
      "textDecoration": true,
      "textTransform": true,
      "fontFamilies": [
        {
          "name": "Sora (Headings)",
          "slug": "sora",
          "fontFamily": "\"Sora\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
        },
        {
          "name": "Manrope (Body)",
          "slug": "manrope",
          "fontFamily": "\"Manrope\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        { "name": "Small", "slug": "small", "size": "0.875rem" },
        { "name": "Regular", "slug": "regular", "size": "1rem" },
        { "name": "Medium", "slug": "medium", "size": "1.125rem" },
        { "name": "Large", "slug": "large", "size": "1.25rem" },
        { "name": "Extra Large", "slug": "x-large", "size": "1.5rem" },
        { "name": "2X Large", "slug": "2x-large", "size": "1.875rem" },
        { "name": "3X Large", "slug": "3x-large", "size": "2.25rem" },
        { "name": "4X Large", "slug": "4x-large", "size": "3rem" },
        { "name": "Hero", "slug": "hero", "size": "3.75rem" }
      ]
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "%", "vh", "vw"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--manrope)",
      "fontSize": "var(--wp--preset--font-size--regular)",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sora)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "var(--wp--preset--color--foreground)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "border": {
          "radius": "9999px"
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#FFFFFF"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      }
    }
  }
}
